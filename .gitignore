# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# IDE & AI Assistant internal metadata / caches
.idea/
.claude/
.gemini/
.vscode/
tmp/
scratch/
cache/
logs/

# EXCLUDE INTERNAL DRAFTS, MANUSCRIPT SOURCES, CONGRESS NOTES, AND REVIEWS
paper/
abstracts/
reviews/
docs/
references/
qgis/
src/
AGENTS.md
project_guide.md
restored_pilot13.py
figs_current/
data/README.md
outputs/README.md

# Heavy / local raw GIS raster & vector data (reproducible via scripts)
data/00_external/
data/01_raw/
data/02_interim/
*.gpkg
*.tif
*.tiff
*.geotiff
*.zip
*.tar.gz
*.parquet

# Heavy outputs & archives
outputs/figure_gpkgs/
outputs/*.zip
outputs/*.tar.gz

# QGIS autosaves and temporary files
*.qgz~
*.qgs~
*.gpkg-wal
*.gpkg-shm
*.gpkg.style

