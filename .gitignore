# ==============================================================================
# Git Ignore Rules for Open-Source Research Code & Reproducibility Repository
# Repository: explainable-urban-resilience-screening
# ==============================================================================

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# IDE & AI Assistant internal metadata / caches
.idea/
.claude/
.gemini/
.vscode/
tmp/
scratch/
cache/
logs/

# EXCLUDE UNPUBLISHED EDITABLE MANUSCRIPT LATEX SOURCE & INTERNAL DRAFT NOTES
# (Ensures compliance with journal open-science & double-blind policies)
paper/
abstracts/
reviews/
docs/revision/
docs/submission/
AGENTS.md
project_guide.md
restored_pilot13.py
figs_current/

# Heavy / local raw GIS raster & vector data (reproducible via scripts)
data/00_external/
data/01_raw/
data/02_interim/
*.gpkg
*.tif
*.tiff
*.geotiff
*.zip
*.tar.gz
*.parquet

# Heavy outputs & archives
outputs/figure_gpkgs/
outputs/*.zip
outputs/*.tar.gz

# QGIS autosaves and temporary files
*.qgz~
*.qgs~
*.gpkg-wal
*.gpkg-shm
*.gpkg.style
